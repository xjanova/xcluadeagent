# XcluadeAgent Docker Environment Variables
# Copy this file to .env and update the values

# REQUIRED - JWT Secret for authentication
# Generate with: openssl rand -base64 32
JWT_SECRET=change_this_to_a_random_string_at_least_32_characters

# REQUIRED - GitHub Personal Access Token
# Create at: https://github.com/settings/tokens
# Required scopes: repo, read:org (if using organization repos)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED - GitHub Webhook Secret
# Generate with: openssl rand -hex 20
# Use the same secret when configuring webhooks in GitHub
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# OPTIONAL - Customize the port (default: 5000)
# PORT=5000

# OPTIONAL - Enable development mode
# ASPNETCORE_ENVIRONMENT=Development
