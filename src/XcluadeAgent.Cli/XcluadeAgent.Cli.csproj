<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>XcluadeAgent.Cli</RootNamespace>
    <AssemblyName>syncctl</AssemblyName>
    <Company>xman studio</Company>
    <Product>XcluadeAgent</Product>
    <Authors>xman studio</Authors>
    <Description>CLI tool for XcluadeAgent</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>syncctl</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XcluadeAgent.Core\XcluadeAgent.Core.csproj" />
    <ProjectReference Include="..\XcluadeAgent.Shared\XcluadeAgent.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.7" />
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
  </ItemGroup>

</Project>
