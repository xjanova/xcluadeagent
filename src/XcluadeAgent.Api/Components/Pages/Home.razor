@page "/"
@using XcluadeAgent.Shared.DTOs
@using Microsoft.AspNetCore.SignalR.Client
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Dashboard - XcluadeAgent</PageTitle>

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold">Dashboard</h1>
            <p class="text-gray-400">Overview of your sync operations</p>
        </div>
        <div class="flex items-center space-x-2">
            <span class="text-sm @(isConnected ? "text-green-400" : "text-gray-500")">
                @(isConnected ? "🟢 Live" : "⚪ Offline")
            </span>
            <button class="btn-secondary flex items-center space-x-2" @onclick="RefreshDashboard">
                <span>🔄 Refresh</span>
            </button>
            <a href="/projects" class="btn-primary flex items-center space-x-2">
                <span>➕ Add Project</span>
            </a>
        </div>
    </div>

    <!-- GitHub One-Click Setup Banner -->
    @if (gitHubStatus != null && !gitHubStatus.IsLinked && gitHubStatus.IsOAuthConfigured)
    {
        <div class="bg-gradient-to-r from-gray-800 to-gray-900 border border-gray-700 rounded-lg p-6">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-4">
                    <div class="w-14 h-14 rounded-full bg-gray-700 flex items-center justify-center">
                        <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold text-white">Connect Your GitHub Account</h3>
                        <p class="text-gray-400 text-sm">One-click setup to sync your repositories automatically</p>
                    </div>
                </div>
                <button @onclick="ConnectGitHub"
                        disabled="@isConnectingGitHub"
                        class="btn-primary flex items-center space-x-2 px-6 py-3 @(isConnectingGitHub ? "opacity-50 cursor-not-allowed" : "")">
                    @if (isConnectingGitHub)
                    {
                        <span class="animate-spin">⏳</span>
                        <span>Connecting...</span>
                    }
                    else
                    {
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                        </svg>
                        <span>One-Click Setup</span>
                    }
                </button>
            </div>
        </div>
    }

    <!-- GitHub Connected Status -->
    @if (gitHubStatus != null && gitHubStatus.IsLinked)
    {
        <div class="bg-green-500/10 border border-green-500/50 rounded-lg p-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-full bg-green-500/20 flex items-center justify-center">
                        <svg class="w-6 h-6 text-green-400" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-green-400 font-medium">
                            GitHub Connected: <span class="text-white">@@@gitHubStatus.GitHubUsername</span>
                        </p>
                        <p class="text-sm text-gray-400">
                            Linked @(gitHubStatus.LinkedAt?.ToString("MMM dd, yyyy") ?? "recently")
                        </p>
                    </div>
                </div>
                <button @onclick="DisconnectGitHub" class="text-gray-400 hover:text-red-400 text-sm">
                    Disconnect
                </button>
            </div>
        </div>
    }

    <!-- GitHub Success/Error Messages -->
    @if (!string.IsNullOrEmpty(gitHubMessage))
    {
        <div class="@(gitHubSuccess ? "bg-green-500/10 border-green-500/50 text-green-400" : "bg-red-500/10 border-red-500/50 text-red-400") border rounded-lg p-4 flex items-center justify-between">
            <span>@gitHubMessage</span>
            <button @onclick="() => gitHubMessage = null" class="text-current hover:opacity-70">✕</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="bg-red-500/10 border border-red-500/50 rounded-lg p-4 text-red-400">
            @errorMessage
        </div>
    }

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card p-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-gray-400 text-sm">Total Projects</p>
                    <p class="text-3xl font-bold">@(overview?.TotalProjects ?? 0)</p>
                </div>
                <div class="w-12 h-12 rounded-lg bg-blue-500/20 flex items-center justify-center text-2xl">
                    📁
                </div>
            </div>
        </div>

        <div class="card p-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-gray-400 text-sm">Synced</p>
                    <p class="text-3xl font-bold text-green-500">@(overview?.SyncedProjects ?? 0)</p>
                </div>
                <div class="w-12 h-12 rounded-lg bg-green-500/20 flex items-center justify-center text-2xl">
                    ✅
                </div>
            </div>
        </div>

        <div class="card p-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-gray-400 text-sm">Pending</p>
                    <p class="text-3xl font-bold text-yellow-500">@(overview?.PendingProjects ?? 0)</p>
                </div>
                <div class="w-12 h-12 rounded-lg bg-yellow-500/20 flex items-center justify-center text-2xl">
                    ⏳
                </div>
            </div>
        </div>

        <div class="card p-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-gray-400 text-sm">Failed</p>
                    <p class="text-3xl font-bold text-red-500">@(overview?.FailedProjects ?? 0)</p>
                </div>
                <div class="w-12 h-12 rounded-lg bg-red-500/20 flex items-center justify-center text-2xl">
                    ❌
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Projects List -->
        <div class="lg:col-span-2 card">
            <div class="p-4 border-b border-gray-700">
                <h2 class="text-lg font-semibold">Recent Projects</h2>
            </div>
            <div class="divide-y divide-gray-700">
                @if (overview?.RecentProjects != null)
                {
                    @foreach (var project in overview.RecentProjects)
                    {
                        <div class="p-4 hover:bg-gray-700/50 transition-colors">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center space-x-3">
                                    <div class="w-10 h-10 rounded-lg bg-gray-700 flex items-center justify-center">
                                        📦
                                    </div>
                                    <div>
                                        <h3 class="font-medium">@project.Name</h3>
                                        <p class="text-sm text-gray-400">@project.Framework • @project.LocalPath</p>
                                    </div>
                                </div>
                                <div class="flex items-center space-x-4">
                                    <div class="text-right">
                                        <p class="text-sm @GetStatusClass(project.Status)">@project.Status</p>
                                        <p class="text-xs text-gray-500">@project.LastSyncAgo</p>
                                    </div>
                                    <button class="btn-primary text-sm px-3 py-1">Sync</button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="p-8 text-center text-gray-500">
                        <p>No projects yet. Add your first project to get started!</p>
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
            <!-- System Health -->
            <div class="card p-4">
                <h2 class="text-lg font-semibold mb-4">System Health</h2>
                @if (overview?.SystemHealth != null)
                {
                    <div class="space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-gray-400">Status</span>
                            <span class="text-@(overview.SystemHealth.StatusColor)-500 font-medium">
                                @overview.SystemHealth.Status
                            </span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-400">Disk Usage</span>
                            <span>@overview.SystemHealth.DiskUsage</span>
                        </div>
                        <div class="w-full bg-gray-700 rounded-full h-2">
                            <div class="bg-blue-500 h-2 rounded-full"
                                 style="width: @(overview.SystemHealth.DiskUsagePercent)%"></div>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-400">Uptime</span>
                            <span>@overview.SystemHealth.Uptime</span>
                        </div>
                    </div>
                }
            </div>

            <!-- AI Status -->
            <div class="card p-4">
                <h2 class="text-lg font-semibold mb-4">AI Assistant</h2>
                @if (overview?.AiStatus != null)
                {
                    <div class="space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-gray-400">Status</span>
                            <span class="@(overview.AiStatus.Enabled ? "text-green-500" : "text-gray-500")">
                                @(overview.AiStatus.Enabled ? "Enabled" : "Disabled")
                            </span>
                        </div>
                        @if (overview.AiStatus.Enabled)
                        {
                            <div class="flex items-center justify-between">
                                <span class="text-gray-400">Provider</span>
                                <span>@overview.AiStatus.Provider</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-gray-400">GPU</span>
                                <span>@(overview.AiStatus.HasGpu ? "Available" : "CPU Only")</span>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- License -->
            <div class="card p-4">
                <h2 class="text-lg font-semibold mb-4">License</h2>
                @if (overview?.License != null)
                {
                    <div class="space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-gray-400">Type</span>
                            <span class="px-2 py-0.5 rounded text-sm bg-@(overview.License.TypeColor)-500/20 text-@(overview.License.TypeColor)-400">
                                @overview.License.Type
                            </span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-400">Projects</span>
                            <span>@overview.License.ProjectsUsed / @overview.License.ProjectsLimit</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-400">Users</span>
                            <span>@overview.License.UsersUsed / @overview.License.UsersLimit</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="card">
        <div class="p-4 border-b border-gray-700">
            <h2 class="text-lg font-semibold">Recent Activity</h2>
        </div>
        <div class="divide-y divide-gray-700">
            @if (overview?.RecentActivity != null)
            {
                @foreach (var activity in overview.RecentActivity)
                {
                    <div class="p-4 flex items-center space-x-4">
                        <div class="w-10 h-10 rounded-full bg-@(activity.TypeColor)-500/20 flex items-center justify-center">
                            @activity.TypeIcon
                        </div>
                        <div class="flex-1">
                            <p class="font-medium">@activity.Title</p>
                            <p class="text-sm text-gray-400">@activity.ProjectName • @activity.Description</p>
                        </div>
                        <div class="text-sm text-gray-500">
                            @activity.TimeAgo
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private DashboardOverviewDto? overview;
    private string? errorMessage;
    private HubConnection? hubConnection;
    private bool isConnected = false;
    private List<string> liveUpdates = new();

    // GitHub OAuth state
    private GitHubOAuthStatusResponse? gitHubStatus;
    private bool isConnectingGitHub = false;
    private string? gitHubMessage;
    private bool gitHubSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardDataAsync();
        await LoadGitHubStatusAsync();
        await SetupSignalRAsync();
        await CheckGitHubCallbackAsync();
    }

    private async Task CheckGitHubCallbackAsync()
    {
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        if (query["github_success"] == "true")
        {
            var githubUser = query["github_user"];
            gitHubSuccess = true;
            gitHubMessage = $"Successfully connected to GitHub as @{githubUser}!";
            await LoadGitHubStatusAsync();
            // Clear query params
            Navigation.NavigateTo("/", replace: true);
        }
        else if (!string.IsNullOrEmpty(query["github_error"]))
        {
            gitHubSuccess = false;
            gitHubMessage = $"GitHub connection failed: {query["github_error"]}";
            Navigation.NavigateTo("/", replace: true);
        }
    }

    private async Task LoadGitHubStatusAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<GitHubOAuthStatusResponse>>("api/v1/auth/github/status");
            if (response?.Success == true)
            {
                gitHubStatus = response.Data;
            }
        }
        catch
        {
            // Ignore - GitHub status is optional
        }
    }

    private async Task ConnectGitHub()
    {
        isConnectingGitHub = true;
        gitHubMessage = null;
        StateHasChanged();

        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<GitHubOAuthUrlResponse>>("api/v1/auth/github/authorize");

            if (response?.Success == true && response.Data != null)
            {
                // Redirect to GitHub OAuth page
                Navigation.NavigateTo(response.Data.AuthorizationUrl, forceLoad: true);
            }
            else
            {
                gitHubSuccess = false;
                gitHubMessage = response?.Message ?? "Failed to get GitHub authorization URL";
            }
        }
        catch (Exception ex)
        {
            gitHubSuccess = false;
            gitHubMessage = $"Error connecting to GitHub: {ex.Message}";
        }
        finally
        {
            isConnectingGitHub = false;
            StateHasChanged();
        }
    }

    private async Task DisconnectGitHub()
    {
        try
        {
            var response = await Http.PostAsync("api/v1/auth/github/unlink", null);
            var result = await response.Content.ReadFromJsonAsync<ApiResponse>();

            if (result?.Success == true)
            {
                gitHubStatus = null;
                gitHubSuccess = true;
                gitHubMessage = "GitHub account disconnected successfully";
                await LoadGitHubStatusAsync();
            }
            else
            {
                gitHubSuccess = false;
                gitHubMessage = result?.Message ?? "Failed to disconnect GitHub account";
            }
        }
        catch (Exception ex)
        {
            gitHubSuccess = false;
            gitHubMessage = $"Error disconnecting GitHub: {ex.Message}";
        }

        StateHasChanged();
    }

    private async Task SetupSignalRAsync()
    {
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hubs/sync"))
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<object>("SyncStarted", async (data) =>
            {
                liveUpdates.Insert(0, $"🔄 Sync started");
                if (liveUpdates.Count > 5) liveUpdates.RemoveAt(5);
                await InvokeAsync(StateHasChanged);
            });

            hubConnection.On<object>("SyncCompleted", async (data) =>
            {
                liveUpdates.Insert(0, $"✅ Sync completed");
                if (liveUpdates.Count > 5) liveUpdates.RemoveAt(5);
                await LoadDashboardDataAsync();
                await InvokeAsync(StateHasChanged);
            });

            hubConnection.On<object>("SyncProgress", async (data) =>
            {
                await InvokeAsync(StateHasChanged);
            });

            hubConnection.Closed += async (ex) =>
            {
                isConnected = false;
                await InvokeAsync(StateHasChanged);
            };

            hubConnection.Reconnected += async (id) =>
            {
                isConnected = true;
                await InvokeAsync(StateHasChanged);
            };

            await hubConnection.StartAsync();
            await hubConnection.SendAsync("SubscribeToAllSyncs");
            isConnected = true;
        }
        catch
        {
            // SignalR is optional, continue without real-time updates
        }
    }

    private async Task LoadDashboardDataAsync()
    {
        try
        {
            errorMessage = null;

            var response = await Http.GetFromJsonAsync<ApiResponse<DashboardOverviewDto>>("api/v1/dashboard/overview");

            if (response?.Success == true && response.Data != null)
            {
                overview = response.Data;
            }
            else
            {
                // Fallback to empty state if API returns error
                overview = new DashboardOverviewDto
                {
                    TotalProjects = 0,
                    SyncedProjects = 0,
                    PendingProjects = 0,
                    FailedProjects = 0,
                    SystemHealth = new SystemHealthDto
                    {
                        Status = "Unknown",
                        StatusColor = "gray",
                        DiskUsage = "N/A",
                        DiskUsagePercent = 0,
                        Uptime = "N/A"
                    },
                    AiStatus = new AiStatusDto
                    {
                        Enabled = false,
                        Provider = "None",
                        HasGpu = false
                    },
                    License = new LicenseInfoDto
                    {
                        Type = "Community",
                        TypeColor = "gray",
                        ProjectsUsed = 0,
                        ProjectsLimit = 3,
                        UsersUsed = 1,
                        UsersLimit = 1
                    }
                };
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Failed to load dashboard: {ex.Message}";
            overview = CreateEmptyOverview();
        }
        catch (Exception ex)
        {
            errorMessage = $"Unexpected error: {ex.Message}";
            overview = CreateEmptyOverview();
        }
    }

    private static DashboardOverviewDto CreateEmptyOverview() => new()
    {
        TotalProjects = 0,
        SyncedProjects = 0,
        PendingProjects = 0,
        FailedProjects = 0,
        SystemHealth = new SystemHealthDto
        {
            Status = "Offline",
            StatusColor = "red",
            DiskUsage = "N/A",
            DiskUsagePercent = 0,
            Uptime = "N/A"
        },
        AiStatus = new AiStatusDto
        {
            Enabled = false,
            Provider = "None",
            HasGpu = false
        },
        License = new LicenseInfoDto
        {
            Type = "Unknown",
            TypeColor = "gray",
            ProjectsUsed = 0,
            ProjectsLimit = 0,
            UsersUsed = 0,
            UsersLimit = 0
        }
    };

    private async Task RefreshDashboard()
    {
        await LoadDashboardDataAsync();
        StateHasChanged();
    }

    private string GetStatusClass(string status) => status switch
    {
        "Synced" => "text-green-500",
        "Pending" or "Syncing" => "text-yellow-500",
        "Failed" => "text-red-500",
        _ => "text-gray-500"
    };

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
