@page "/update"
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>System Update - XcluadeAgent</PageTitle>

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold">System Update</h1>
            <p class="text-gray-400">Keep XcluadeAgent up to date</p>
        </div>
        <button class="btn-secondary flex items-center space-x-2" @onclick="CheckForUpdate" disabled="@isChecking">
            @if (isChecking)
            {
                <span class="animate-spin">@("[*]")</span>
                <span>Checking...</span>
            }
            else
            {
                <span>@("[R]")</span>
                <span>Check for Updates</span>
            }
        </button>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="bg-red-500/20 border border-red-500 text-red-300 p-4 rounded-lg">
            @errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="bg-green-500/20 border border-green-500 text-green-300 p-4 rounded-lg">
            @successMessage
        </div>
    }

    <!-- Current Version -->
    <div class="card p-6">
        <div class="flex items-center justify-between">
            <div class="flex items-center space-x-4">
                <div class="w-16 h-16 rounded-xl bg-blue-500/20 flex items-center justify-center text-3xl">
                    X
                </div>
                <div>
                    <h2 class="text-xl font-bold">XcluadeAgent</h2>
                    <p class="text-gray-400">Version @currentVersion</p>
                    @if (!string.IsNullOrEmpty(buildDate))
                    {
                        <p class="text-sm text-gray-500">Built: @buildDate</p>
                    }
                </div>
            </div>
            @if (updateInfo?.UpdateAvailable == true)
            {
                <span class="px-3 py-1 rounded-full bg-green-500/20 text-green-400 text-sm font-medium">
                    Update Available!
                </span>
            }
            else if (lastChecked.HasValue)
            {
                <span class="px-3 py-1 rounded-full bg-gray-500/20 text-gray-400 text-sm">
                    Up to date
                </span>
            }
        </div>
    </div>

    <!-- Update Available -->
    @if (updateInfo?.UpdateAvailable == true)
    {
        <div class="card p-6 border-2 border-green-500/50">
            <div class="flex items-start justify-between mb-4">
                <div>
                    <h3 class="text-lg font-semibold text-green-400">New Version Available</h3>
                    <p class="text-2xl font-bold mt-1">v@(updateInfo.LatestVersion)</p>
                    @if (updateInfo.PublishedAt.HasValue)
                    {
                        <p class="text-sm text-gray-400 mt-1">
                            Released @updateInfo.PublishedAt.Value.ToString("MMMM dd, yyyy")
                        </p>
                    }
                </div>
                <div class="text-right">
                    @if (updateInfo.DownloadSizeMb.HasValue)
                    {
                        <p class="text-sm text-gray-400">Download size</p>
                        <p class="font-mono">@updateInfo.DownloadSizeMb.Value MB</p>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(updateInfo.ReleaseNotes))
            {
                <div class="mb-6">
                    <h4 class="font-medium mb-2">Release Notes</h4>
                    <div class="bg-gray-800 rounded-lg p-4 text-sm text-gray-300 max-h-64 overflow-y-auto whitespace-pre-wrap">
                        @updateInfo.ReleaseNotes
                    </div>
                </div>
            }

            <div class="flex items-center justify-between">
                <div class="text-sm text-gray-400">
                    <p>* Backup will be created before update</p>
                    <p>* Application will restart after update</p>
                </div>
                <button class="btn-primary flex items-center space-x-2 text-lg px-6 py-3"
                        @onclick="ApplyUpdate" disabled="@isUpdating">
                    @if (isUpdating)
                    {
                        <span class="animate-spin">@("[*]")</span>
                        <span>Updating...</span>
                    }
                    else
                    {
                        <span>@("[^]")</span>
                        <span>Update Now</span>
                    }
                </button>
            </div>
        </div>
    }

    <!-- Update Progress -->
    @if (isUpdating)
    {
        <div class="card p-6">
            <h3 class="text-lg font-semibold mb-4">Update Progress</h3>
            <div class="space-y-3">
                <div class="flex items-center space-x-3">
                    <span class="@(updateStep >= 1 ? "text-green-500" : "text-gray-500")">
                        @(updateStep >= 1 ? "[v]" : "[ ]")
                    </span>
                    <span class="@(updateStep >= 1 ? "" : "text-gray-500")">Creating backup...</span>
                </div>
                <div class="flex items-center space-x-3">
                    <span class="@(updateStep >= 2 ? "text-green-500" : "text-gray-500")">
                        @(updateStep >= 2 ? "[v]" : "[ ]")
                    </span>
                    <span class="@(updateStep >= 2 ? "" : "text-gray-500")">Downloading update...</span>
                </div>
                <div class="flex items-center space-x-3">
                    <span class="@(updateStep >= 3 ? "text-green-500" : "text-gray-500")">
                        @(updateStep >= 3 ? "[v]" : "[ ]")
                    </span>
                    <span class="@(updateStep >= 3 ? "" : "text-gray-500")">Extracting files...</span>
                </div>
                <div class="flex items-center space-x-3">
                    <span class="@(updateStep >= 4 ? "text-green-500" : "text-gray-500")">
                        @(updateStep >= 4 ? "[v]" : "[ ]")
                    </span>
                    <span class="@(updateStep >= 4 ? "" : "text-gray-500")">Restarting application...</span>
                </div>
            </div>
            @if (updateStep >= 4)
            {
                <div class="mt-4 p-4 bg-yellow-500/20 rounded-lg text-yellow-300">
                    <p class="font-medium">Application will restart shortly...</p>
                    <p class="text-sm mt-1">This page will reload automatically.</p>
                </div>
            }
        </div>
    }

    <!-- No Update Available Info -->
    @if (updateInfo != null && !updateInfo.UpdateAvailable && string.IsNullOrEmpty(updateInfo.ErrorMessage))
    {
        <div class="card p-6">
            <div class="flex items-center space-x-4">
                <div class="w-12 h-12 rounded-full bg-green-500/20 flex items-center justify-center text-2xl text-green-500">
                    [v]
                </div>
                <div>
                    <h3 class="text-lg font-semibold">You're up to date!</h3>
                    <p class="text-gray-400">
                        XcluadeAgent v@currentVersion is the latest version.
                    </p>
                </div>
            </div>
        </div>
    }

    <!-- Update History -->
    <div class="card p-6">
        <h3 class="text-lg font-semibold mb-4">Update History</h3>
        @if (updateHistory.Any())
        {
            <div class="space-y-3">
                @foreach (var entry in updateHistory.Take(10))
                {
                    <div class="flex items-center justify-between p-3 bg-gray-800 rounded-lg">
                        <div class="flex items-center space-x-3">
                            <span class="@(entry.Success ? "text-green-500" : "text-red-500")">
                                @(entry.Success ? "[v]" : "[x]")
                            </span>
                            <div>
                                <p class="font-medium">
                                    @entry.FromVersion → @entry.ToVersion
                                </p>
                                <p class="text-sm text-gray-400">
                                    @entry.UpdatedAt.ToString("yyyy-MM-dd HH:mm:ss")
                                </p>
                            </div>
                        </div>
                        @if (!entry.Success && !string.IsNullOrEmpty(entry.ErrorMessage))
                        {
                            <span class="text-sm text-red-400">@entry.ErrorMessage</span>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-gray-400 text-center py-8">No update history</p>
        }
    </div>

    <!-- Auto-Update Settings -->
    <div class="card p-6">
        <h3 class="text-lg font-semibold mb-4">Auto-Update Settings</h3>
        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="font-medium">Check for updates automatically</p>
                    <p class="text-sm text-gray-400">Check for new versions daily</p>
                </div>
                <label class="toggle">
                    <input type="checkbox" @bind="autoCheckEnabled" />
                    <span class="toggle-slider"></span>
                </label>
            </div>
            <div class="flex items-center justify-between">
                <div>
                    <p class="font-medium">Notify when update is available</p>
                    <p class="text-sm text-gray-400">Show notification in dashboard</p>
                </div>
                <label class="toggle">
                    <input type="checkbox" @bind="notifyEnabled" />
                    <span class="toggle-slider"></span>
                </label>
            </div>
        </div>
        @if (lastChecked.HasValue)
        {
            <p class="text-sm text-gray-500 mt-4">
                Last checked: @lastChecked.Value.ToString("yyyy-MM-dd HH:mm:ss")
            </p>
        }
    </div>
</div>

@code {
    private string currentVersion = "Loading...";
    private string? buildDate;
    private UpdateCheckDto? updateInfo;
    private List<UpdateHistoryDto> updateHistory = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isChecking = false;
    private bool isUpdating = false;
    private int updateStep = 0;
    private DateTime? lastChecked;
    private bool autoCheckEnabled = true;
    private bool notifyEnabled = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadVersionInfo();
        await LoadUpdateHistory();
        await CheckForUpdate();
    }

    private async Task LoadVersionInfo()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
            if (!string.IsNullOrEmpty(token))
            {
                Http.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var response = await Http.GetFromJsonAsync<ApiResponse<VersionInfoDto>>("/api/v1/update/version");
            if (response?.Success == true && response.Data != null)
            {
                currentVersion = response.Data.Version;
                buildDate = response.Data.BuildDate;
            }
        }
        catch (Exception ex)
        {
            currentVersion = "Unknown";
            errorMessage = $"Failed to load version info: {ex.Message}";
        }
    }

    private async Task LoadUpdateHistory()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
            if (!string.IsNullOrEmpty(token))
            {
                Http.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var response = await Http.GetFromJsonAsync<ApiResponse<List<UpdateHistoryDto>>>("/api/v1/update/history");
            if (response?.Success == true && response.Data != null)
            {
                updateHistory = response.Data;
            }
        }
        catch
        {
            // Silently fail - history is optional
        }
    }

    private async Task CheckForUpdate()
    {
        isChecking = true;
        errorMessage = null;
        successMessage = null;
        StateHasChanged();

        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
            if (!string.IsNullOrEmpty(token))
            {
                Http.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var response = await Http.GetFromJsonAsync<ApiResponse<UpdateCheckDto>>("/api/v1/update/check");
            if (response?.Success == true && response.Data != null)
            {
                updateInfo = response.Data;
                lastChecked = DateTime.Now;

                if (updateInfo.UpdateAvailable)
                {
                    successMessage = $"New version {updateInfo.LatestVersion} is available!";
                }
                else if (!string.IsNullOrEmpty(updateInfo.ErrorMessage))
                {
                    errorMessage = updateInfo.ErrorMessage;
                }
            }
            else
            {
                errorMessage = response?.Errors?.FirstOrDefault() ?? "Failed to check for updates";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to check for updates: {ex.Message}";
        }
        finally
        {
            isChecking = false;
        }
    }

    private async Task ApplyUpdate()
    {
        if (updateInfo?.LatestVersion == null) return;

        isUpdating = true;
        updateStep = 0;
        errorMessage = null;
        successMessage = null;
        StateHasChanged();

        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");
            if (!string.IsNullOrEmpty(token))
            {
                Http.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            // Simulate progress
            updateStep = 1;
            StateHasChanged();
            await Task.Delay(500);

            updateStep = 2;
            StateHasChanged();

            var response = await Http.PostAsJsonAsync("/api/v1/update/apply",
                new { Version = updateInfo.LatestVersion });
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<UpdateResultDto>>();

            if (result?.Success == true && result.Data?.Success == true)
            {
                updateStep = 3;
                StateHasChanged();
                await Task.Delay(1000);

                updateStep = 4;
                StateHasChanged();

                successMessage = "Update installed successfully! Restarting...";

                // Trigger restart
                await Http.PostAsync("/api/v1/update/restart", null);

                // Wait and reload page
                await Task.Delay(5000);
                await JS.InvokeVoidAsync("location.reload");
            }
            else
            {
                errorMessage = result?.Data?.ErrorMessage ?? result?.Errors?.FirstOrDefault() ?? "Update failed";
                isUpdating = false;
                updateStep = 0;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Update failed: {ex.Message}";
            isUpdating = false;
            updateStep = 0;
        }
    }

    private class ApiResponse<T>
    {
        public bool Success { get; set; }
        public T? Data { get; set; }
        public List<string>? Errors { get; set; }
    }

    private class VersionInfoDto
    {
        public string Version { get; set; } = "";
        public string BuildDate { get; set; } = "";
    }

    private class UpdateCheckDto
    {
        public bool UpdateAvailable { get; set; }
        public string CurrentVersion { get; set; } = "";
        public string? LatestVersion { get; set; }
        public string? ReleaseNotes { get; set; }
        public string? DownloadUrl { get; set; }
        public DateTime? PublishedAt { get; set; }
        public double? DownloadSizeMb { get; set; }
        public string? ErrorMessage { get; set; }
    }

    private class UpdateResultDto
    {
        public bool Success { get; set; }
        public string? ErrorMessage { get; set; }
    }

    private class UpdateHistoryDto
    {
        public string FromVersion { get; set; } = "";
        public string ToVersion { get; set; } = "";
        public DateTime UpdatedAt { get; set; }
        public bool Success { get; set; }
        public string? ErrorMessage { get; set; }
    }
}
