@page "/ai-assistant"
@using XcluadeAgent.Shared.DTOs
@using Microsoft.AspNetCore.SignalR.Client
@inject HttpClient Http
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>AI Assistant - XcluadeAgent</PageTitle>

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold">AI Assistant</h1>
            <p class="text-gray-400">Analyze errors and get AI-powered fix suggestions</p>
        </div>
        <div class="flex items-center space-x-2">
            @if (aiStatus != null)
            {
                <span class="px-3 py-1 rounded-full text-sm @(aiStatus.IsAvailable ? "bg-green-500/20 text-green-400" : "bg-red-500/20 text-red-400")">
                    @(aiStatus.IsAvailable ? "🟢 AI Available" : "🔴 AI Unavailable")
                </span>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="bg-red-500/10 border border-red-500/50 rounded-lg p-4 text-red-400">
            @errorMessage
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Left Panel: Analysis Input -->
        <div class="lg:col-span-2 space-y-6">
            <!-- AI Status Card -->
            @if (aiStatus != null)
            {
                <div class="card p-4">
                    <h2 class="text-lg font-semibold mb-4">AI Configuration</h2>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <div>
                            <p class="text-gray-400 text-sm">Provider</p>
                            <p class="font-medium">@aiStatus.ActiveProvider</p>
                        </div>
                        <div>
                            <p class="text-gray-400 text-sm">Model</p>
                            <p class="font-medium">@(aiStatus.Model ?? "Default")</p>
                        </div>
                        <div>
                            <p class="text-gray-400 text-sm">GPU</p>
                            <p class="font-medium @(aiStatus.HasGpu ? "text-green-400" : "text-gray-500")">
                                @(aiStatus.HasGpu ? "Available" : "CPU Only")
                            </p>
                        </div>
                        <div>
                            <p class="text-gray-400 text-sm">Budget Used</p>
                            <p class="font-medium">@(aiStatus.Usage?.BudgetUsedPercent ?? 0)%</p>
                        </div>
                    </div>
                    @if (aiStatus.Usage != null && aiStatus.Usage.BudgetUsd > 0)
                    {
                        <div class="mt-4">
                            <div class="flex justify-between text-sm mb-1">
                                <span class="text-gray-400">Monthly Budget</span>
                                <span>$@aiStatus.Usage.TotalCostUsd.ToString("F2") / $@aiStatus.Usage.BudgetUsd.ToString("F2")</span>
                            </div>
                            <div class="w-full bg-gray-700 rounded-full h-2">
                                <div class="bg-blue-500 h-2 rounded-full" style="width: @(aiStatus.Usage.BudgetUsedPercent)%"></div>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Error Analysis Form -->
            <div class="card p-4">
                <h2 class="text-lg font-semibold mb-4">Analyze Error</h2>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium mb-2">Project</label>
                        <select @bind="selectedProjectId" class="input w-full">
                            <option value="">Select a project...</option>
                            @if (failedSyncs != null)
                            {
                                @foreach (var project in failedSyncs.Select(f => new { f.ProjectId, f.ProjectName }).Distinct())
                                {
                                    <option value="@project.ProjectId">@project.ProjectName</option>
                                }
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-medium mb-2">Error Message</label>
                        <textarea @bind="errorInput" rows="4" class="input w-full font-mono text-sm"
                                  placeholder="Paste the error message here..."></textarea>
                    </div>

                    <div>
                        <label class="block text-sm font-medium mb-2">Stack Trace (Optional)</label>
                        <textarea @bind="stackTraceInput" rows="6" class="input w-full font-mono text-sm"
                                  placeholder="Paste the stack trace here..."></textarea>
                    </div>

                    <div>
                        <label class="block text-sm font-medium mb-2">Log Content (Optional)</label>
                        <textarea @bind="logInput" rows="4" class="input w-full font-mono text-sm"
                                  placeholder="Paste relevant log content..."></textarea>
                    </div>

                    <div class="flex space-x-4">
                        <button class="btn-primary flex-1" @onclick="AnalyzeError" disabled="@(isAnalyzing || !aiStatus?.IsAvailable == true)">
                            @if (isAnalyzing)
                            {
                                <span class="animate-spin mr-2">⏳</span>
                                <span>Analyzing...</span>
                            }
                            else
                            {
                                <span>🔍 Analyze Error</span>
                            }
                        </button>
                        <button class="btn-secondary flex-1" @onclick="GetSuggestion" disabled="@(isAnalyzing || !aiStatus?.IsAvailable == true)">
                            💡 Get Fix Suggestion
                        </button>
                    </div>
                </div>
            </div>

            <!-- Analysis Result -->
            @if (analysisResult != null)
            {
                <div class="card p-4">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-lg font-semibold">Analysis Result</h2>
                        <span class="text-sm text-gray-400">
                            via @analysisResult.Provider • @analysisResult.TokensUsed tokens
                            @if (analysisResult.EstimatedCost > 0)
                            {
                                <span>• ~$@analysisResult.EstimatedCost.ToString("F4")</span>
                            }
                        </span>
                    </div>

                    @if (analysisResult.Success)
                    {
                        <div class="space-y-4">
                            <div class="bg-blue-500/10 border border-blue-500/30 rounded-lg p-4">
                                <h3 class="font-medium text-blue-400 mb-2">Summary</h3>
                                <p>@analysisResult.Summary</p>
                            </div>

                            @if (!string.IsNullOrEmpty(analysisResult.RootCause))
                            {
                                <div class="bg-yellow-500/10 border border-yellow-500/30 rounded-lg p-4">
                                    <h3 class="font-medium text-yellow-400 mb-2">Root Cause</h3>
                                    <p>@analysisResult.RootCause</p>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(analysisResult.Explanation))
                            {
                                <div>
                                    <h3 class="font-medium mb-2">Explanation</h3>
                                    <p class="text-gray-300">@analysisResult.Explanation</p>
                                </div>
                            }

                            @if (analysisResult.PossibleSolutions.Any())
                            {
                                <div>
                                    <h3 class="font-medium mb-2">Possible Solutions</h3>
                                    <ul class="list-disc list-inside space-y-1 text-gray-300">
                                        @foreach (var solution in analysisResult.PossibleSolutions)
                                        {
                                            <li>@solution</li>
                                        }
                                    </ul>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(analysisResult.RecommendedAction))
                            {
                                <div class="bg-green-500/10 border border-green-500/30 rounded-lg p-4">
                                    <h3 class="font-medium text-green-400 mb-2">Recommended Action</h3>
                                    <p>@analysisResult.RecommendedAction</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="bg-red-500/10 border border-red-500/30 rounded-lg p-4">
                            <p class="text-red-400">@analysisResult.ErrorMessage</p>
                        </div>
                    }
                </div>
            }

            <!-- Suggestion Result -->
            @if (suggestionResult != null)
            {
                <div class="card p-4">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-lg font-semibold">Fix Suggestion</h2>
                        <span class="text-sm text-gray-400">
                            via @suggestionResult.Provider • @suggestionResult.TokensUsed tokens
                        </span>
                    </div>

                    @if (suggestionResult.Success)
                    {
                        <div class="space-y-4">
                            @if (!string.IsNullOrEmpty(suggestionResult.Description))
                            {
                                <div class="bg-blue-500/10 border border-blue-500/30 rounded-lg p-4">
                                    <p>@suggestionResult.Description</p>
                                </div>
                            }

                            @if (suggestionResult.Changes.Any())
                            {
                                <div>
                                    <h3 class="font-medium mb-2">Suggested Changes</h3>
                                    @foreach (var change in suggestionResult.Changes)
                                    {
                                        <div class="bg-gray-800 rounded-lg p-4 mb-2">
                                            <div class="flex items-center justify-between mb-2">
                                                <span class="font-mono text-sm text-cyan-400">@change.FilePath</span>
                                                @if (change.LineNumber.HasValue)
                                                {
                                                    <span class="text-gray-500 text-sm">Line @change.LineNumber</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(change.Description))
                                            {
                                                <p class="text-sm text-gray-400 mb-2">@change.Description</p>
                                            }
                                            @if (!string.IsNullOrEmpty(change.BeforeSnippet))
                                            {
                                                <div class="bg-red-900/30 rounded p-2 mb-2">
                                                    <p class="text-xs text-red-400 mb-1">Before:</p>
                                                    <pre class="text-sm overflow-x-auto">@change.BeforeSnippet</pre>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(change.AfterSnippet))
                                            {
                                                <div class="bg-green-900/30 rounded p-2">
                                                    <p class="text-xs text-green-400 mb-1">After:</p>
                                                    <pre class="text-sm overflow-x-auto">@change.AfterSnippet</pre>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @if (suggestionResult.Commands.Any())
                            {
                                <div>
                                    <h3 class="font-medium mb-2">Commands to Run</h3>
                                    <div class="bg-gray-800 rounded-lg p-4">
                                        @foreach (var cmd in suggestionResult.Commands)
                                        {
                                            <code class="block font-mono text-sm text-green-400 mb-1">$ @cmd</code>
                                        }
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(suggestionResult.AdditionalNotes))
                            {
                                <div class="bg-yellow-500/10 border border-yellow-500/30 rounded-lg p-4">
                                    <h3 class="font-medium text-yellow-400 mb-2">Additional Notes</h3>
                                    <p>@suggestionResult.AdditionalNotes</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="bg-red-500/10 border border-red-500/30 rounded-lg p-4">
                            <p class="text-red-400">@suggestionResult.ErrorMessage</p>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Right Panel: Recent Failed Syncs -->
        <div class="space-y-6">
            <div class="card p-4">
                <h2 class="text-lg font-semibold mb-4">Recent Failed Syncs</h2>
                @if (failedSyncs != null && failedSyncs.Any())
                {
                    <div class="space-y-3">
                        @foreach (var sync in failedSyncs)
                        {
                            <div class="p-3 bg-gray-800 rounded-lg hover:bg-gray-700 cursor-pointer transition-colors"
                                 @onclick="() => SelectFailedSync(sync)">
                                <div class="flex items-center justify-between mb-1">
                                    <span class="font-medium">@sync.ProjectName</span>
                                    <span class="text-xs text-gray-500">@GetTimeAgo(sync.StartedAt)</span>
                                </div>
                                <p class="text-sm text-red-400 line-clamp-2">@sync.ErrorMessage</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-gray-500 text-center py-4">No failed syncs to analyze</p>
                }
            </div>

            <!-- AI Modes -->
            <div class="card p-4">
                <h2 class="text-lg font-semibold mb-4">AI Modes</h2>
                @if (aiModes != null)
                {
                    <div class="space-y-2">
                        @foreach (var mode in aiModes)
                        {
                            <div class="p-3 bg-gray-800 rounded-lg">
                                <div class="flex items-center justify-between mb-1">
                                    <span class="font-medium">@mode.DisplayName</span>
                                    <span class="px-2 py-0.5 rounded text-xs bg-@(mode.RiskColor)-500/20 text-@(mode.RiskColor)-400">
                                        @mode.RiskLevel
                                    </span>
                                </div>
                                <p class="text-sm text-gray-400">@mode.Description</p>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Usage Stats -->
            @if (usageStats != null)
            {
                <div class="card p-4">
                    <h2 class="text-lg font-semibold mb-4">Usage (30 Days)</h2>
                    <div class="space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-gray-400">Total Requests</span>
                            <span class="font-medium">@usageStats.TotalRequests</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-400">Tokens Used</span>
                            <span class="font-medium">@usageStats.TotalTokensUsed.ToString("N0")</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-400">Total Cost</span>
                            <span class="font-medium">$@usageStats.TotalCostUsd.ToString("F2")</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private AiStatusDetailDto? aiStatus;
    private List<AiModeInfoDto>? aiModes;
    private List<FailedSyncDto>? failedSyncs;
    private AiUsageStatsDto? usageStats;
    private AiAnalysisResultDto? analysisResult;
    private AiSuggestionResultDto? suggestionResult;

    private string? errorMessage;
    private string? selectedProjectId;
    private string errorInput = "";
    private string stackTraceInput = "";
    private string logInput = "";
    private bool isAnalyzing = false;

    private HubConnection? hubConnection;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        await SetupSignalRAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            var statusTask = Http.GetFromJsonAsync<ApiResponse<AiStatusDetailDto>>("api/v1/ai/status");
            var modesTask = Http.GetFromJsonAsync<ApiResponse<List<AiModeInfoDto>>>("api/v1/ai/modes");
            var failedTask = Http.GetFromJsonAsync<ApiResponse<List<FailedSyncDto>>>("api/v1/ai/failed-syncs");
            var usageTask = Http.GetFromJsonAsync<ApiResponse<AiUsageStatsDto>>("api/v1/ai/usage");

            await Task.WhenAll(statusTask, modesTask, failedTask, usageTask);

            if (statusTask.Result?.Success == true) aiStatus = statusTask.Result.Data;
            if (modesTask.Result?.Success == true) aiModes = modesTask.Result.Data;
            if (failedTask.Result?.Success == true) failedSyncs = failedTask.Result.Data;
            if (usageTask.Result?.Success == true) usageStats = usageTask.Result.Data;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load AI data: {ex.Message}";
        }
    }

    private async Task SetupSignalRAsync()
    {
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/hubs/sync"))
                .WithAutomaticReconnect()
                .Build();

            await hubConnection.StartAsync();
        }
        catch
        {
            // SignalR is optional
        }
    }

    private async Task AnalyzeError()
    {
        if (string.IsNullOrEmpty(errorInput)) return;

        isAnalyzing = true;
        analysisResult = null;
        suggestionResult = null;

        try
        {
            var request = new AiAnalyzeRequest
            {
                ProjectId = Guid.TryParse(selectedProjectId, out var pid) ? pid : Guid.Empty,
                ErrorMessage = errorInput,
                StackTrace = string.IsNullOrWhiteSpace(stackTraceInput) ? null : stackTraceInput,
                LogContent = string.IsNullOrWhiteSpace(logInput) ? null : logInput
            };

            var response = await Http.PostAsJsonAsync("api/v1/ai/analyze", request);
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<AiAnalysisResultDto>>();

            if (result?.Success == true)
            {
                analysisResult = result.Data;
            }
            else
            {
                errorMessage = result?.Errors?.FirstOrDefault() ?? "Analysis failed";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isAnalyzing = false;
        }
    }

    private async Task GetSuggestion()
    {
        if (string.IsNullOrEmpty(errorInput)) return;

        isAnalyzing = true;
        suggestionResult = null;

        try
        {
            var request = new AiAnalyzeRequest
            {
                ProjectId = Guid.TryParse(selectedProjectId, out var pid) ? pid : Guid.Empty,
                ErrorMessage = errorInput,
                StackTrace = string.IsNullOrWhiteSpace(stackTraceInput) ? null : stackTraceInput,
                LogContent = string.IsNullOrWhiteSpace(logInput) ? null : logInput
            };

            var response = await Http.PostAsJsonAsync("api/v1/ai/suggest", request);
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<AiSuggestionResultDto>>();

            if (result?.Success == true)
            {
                suggestionResult = result.Data;
            }
            else
            {
                errorMessage = result?.Errors?.FirstOrDefault() ?? "Suggestion failed";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isAnalyzing = false;
        }
    }

    private void SelectFailedSync(FailedSyncDto sync)
    {
        selectedProjectId = sync.ProjectId.ToString();
        errorInput = sync.ErrorMessage;
        stackTraceInput = "";
        logInput = "";
        analysisResult = null;
        suggestionResult = null;
    }

    private static string GetTimeAgo(DateTime time)
    {
        var diff = DateTime.UtcNow - time;
        if (diff.TotalMinutes < 1) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 30) return $"{(int)diff.TotalDays}d ago";
        return time.ToString("MMM dd");
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
