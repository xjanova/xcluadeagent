<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>XcluadeAgent.Api</RootNamespace>
    <Company>xman studio</Company>
    <Product>XcluadeAgent</Product>
    <Authors>xman studio</Authors>
    <Description>Web API and Dashboard for XcluadeAgent</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XcluadeAgent.Core\XcluadeAgent.Core.csproj" />
    <ProjectReference Include="..\XcluadeAgent.Shared\XcluadeAgent.Shared.csproj" />
    <ProjectReference Include="..\XcluadeAgent.Infrastructure\XcluadeAgent.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Authentication -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.22" />

    <!-- API Documentation -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.0.0" />

    <!-- Blazor -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.22" />

    <!-- SignalR Client for Blazor components -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.11" />

    <!-- YAML Configuration -->
    <PackageReference Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />

    <!-- Logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />

    <!-- Systemd integration for Linux service -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
  </ItemGroup>

</Project>
